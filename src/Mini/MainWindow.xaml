<ui:FluentWindow x:Class="Mini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Mini"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 상단 바 -->
            <RowDefinition Height="Auto" />
            <!-- 메인 영역 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Height="36" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 좌측 Mini OS 타이틀 -->
                <TextBlock Grid.Column="0" Text="Mini" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
            </Grid>
        </Border>

        <!-- 메인 영역-->
        <Canvas x:Name="DesktopCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True">
            <!-- 화면 오브젝트들이 배치될 공간 -->
        </Canvas>
    </Grid>
</ui:FluentWindow>